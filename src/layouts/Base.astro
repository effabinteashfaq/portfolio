---
// Every page uses this: fonts, palette, the sticky room bar and the rug footer.
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/karla/400.css';
import '@fontsource/karla/500.css';
import '@fontsource/karla/700.css';
import '../styles/global.css';
import RoomBar from '../components/RoomBar.astro';
import RugFooter from '../components/RugFooter.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  current?: string;
}
const { title, description, home = false, current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F0E4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <RoomBar home={home} current={current} />
    <main id="main">
      <slot />
    </main>
    <RugFooter home={home} />
  </body>
</html>
