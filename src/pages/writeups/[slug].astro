---
// One page per writeup. Basic version for step 2; book-page styling,
// colourful headings and Mermaid diagrams arrive in step 6.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} · Effa binte Ashfaq`} description={entry.data.excerpt} current="library">
  <article class="writeup wrap">
    <p class="writeup__nav"><a class="writeup__back" href="/#library">← Back to the Library</a></p>
    <p class="writeup__tag">{entry.data.tag}</p>
    <div class="writeup__body">
      <Content />
    </div>
    <p class="writeup__nav"><a class="writeup__back" href="/#library">← Back to the Library</a></p>
  </article>
</Base>

<style>
  /* Text stays at a comfortable reading width; tables, code, figures and
     diagrams spread wider so nothing has to scroll on a laptop. */
  .writeup { max-width: 1160px; padding-top: 40px; padding-bottom: 80px; }
  .writeup__nav, .writeup__tag, .writeup__body > :global(*) { max-width: 720px; margin-left: auto; margin-right: auto; }
  .writeup__nav { margin-top: 0; margin-bottom: 0; }
  .writeup__back { font-weight: 700; }
  .writeup__tag {
    margin-top: 28px; margin-bottom: 0;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--ink-muted);
  }
  .writeup__body :global(h1) { font-size: clamp(34px, 6vw, 48px); line-height: 1.1; margin-top: 8px; margin-bottom: 24px; }
  .writeup__body :global(h2) { font-size: 32px; margin-top: 40px; margin-bottom: 12px; }
  .writeup__body :global(h3) { font-size: 25px; margin-top: 28px; margin-bottom: 8px; }

  /* wide elements */
  .writeup__body > :global(.table-wrap),
  .writeup__body > :global(pre),
  .writeup__body > :global(p:has(> img)),
  .writeup__body > :global(figure) { max-width: 1120px; }
  .writeup__body :global(img) { display: block; height: auto; margin: 0 auto; max-width: 100%; }
  .writeup__body :global(.table-wrap) { overflow-x: auto; margin-top: 24px; margin-bottom: 24px; }
  .writeup__body :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.5; }
  .writeup__body :global(th), .writeup__body :global(td) { border: 1px solid var(--paper-line); padding: 10px 12px; vertical-align: top; text-align: left; }
  .writeup__body :global(th) { background: var(--paper-deep); }
  .writeup__body :global(pre) {
    background: var(--paper-deep);
    padding: 16px 18px;
    border-radius: 8px;
    white-space: pre-wrap;        /* long commands wrap instead of scrolling */
    overflow-wrap: anywhere;
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .writeup__body :global(table) { font-size: 14px; }
    .writeup__body :global(table) { min-width: 560px; }   /* very wide tables may still swipe on phones */
  }
</style>
