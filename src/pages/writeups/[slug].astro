---
// One page per writeup. Basic version for step 2; book-page styling,
// colourful headings and Mermaid diagrams arrive in step 6.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} · Effa binte Ashfaq`} description={entry.data.excerpt} current="library">
  <article class="writeup wrap">
    <a class="writeup__back" href="/#library">← Back to the Library</a>
    <p class="writeup__tag">{entry.data.tag}</p>
    <div class="writeup__body">
      <Content />
    </div>
    <a class="writeup__back" href="/#library">← Back to the Library</a>
  </article>
</Base>

<style>
  .writeup { max-width: 760px; padding-top: 40px; padding-bottom: 80px; }
  .writeup__back { font-weight: 700; }
  .writeup__tag {
    margin: 28px 0 0;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--ink-muted);
  }
  .writeup__body :global(h1) { font-size: clamp(34px, 6vw, 48px); line-height: 1.1; margin: 8px 0 24px; }
  .writeup__body :global(h2) { font-size: 32px; margin: 40px 0 12px; }
  .writeup__body :global(h3) { font-size: 25px; margin: 28px 0 8px; }
  .writeup__body :global(img) { height: auto; }
  .writeup__body :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 15px; }
  .writeup__body :global(th), .writeup__body :global(td) { border: 1px solid var(--paper-line); padding: 8px 10px; vertical-align: top; }
  .writeup__body :global(pre) { overflow-x: auto; background: var(--paper-deep); padding: 16px; border-radius: 8px; }
</style>
