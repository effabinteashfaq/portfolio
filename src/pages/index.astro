---
import Base from '../layouts/Base.astro';
import Threshold from '../components/Threshold.astro';
import Courtyard from '../components/rooms/Courtyard.astro';
import Study from '../components/rooms/Study.astro';
import Veranda from '../components/rooms/Veranda.astro';
import Corridor from '../components/rooms/Corridor.astro';
import Workshop from '../components/rooms/Workshop.astro';
import Library from '../components/rooms/Library.astro';
import BeyondScreen from '../components/rooms/BeyondScreen.astro';
import Ending from '../components/rooms/Ending.astro';
import ChinarSprite from '../components/ChinarSprite.astro';
---
<Base
  home
  title="Effa binte Ashfaq"
  description="Effa binte Ashfaq, Security Researcher and GRC Analyst in Islamabad. A walk through the haveli: research, experience, certifications, projects and writeups."
>
  <ChinarSprite />
  <Courtyard />
  <Threshold from="var(--paper)" to="var(--night)" urdu="مطالعہ" next="the Study" />
  <Study />
  <Threshold from="var(--night)" to="var(--paper)" urdu="برآمدہ" next="the Veranda" />
  <Veranda />
  <Threshold from="var(--paper)" to="var(--paper-deep)" urdu="راہداری" next="the Corridor" />
  <Corridor />
  <Threshold from="var(--paper-deep)" to="var(--paper)" urdu="کارخانہ" next="the Workshop" />
  <Workshop />
  <Threshold from="var(--paper)" via="#F1E6D3" to="var(--paper)" urdu="کتاب گھر" next="the Library" />
  <Library />
  <BeyondScreen />
  <Threshold from="var(--paper)" to="var(--dusk)" urdu="دروازہ" next="the door" />
  <Ending />
</Base>

<script>
  import '../scripts/motion.ts';
</script>
