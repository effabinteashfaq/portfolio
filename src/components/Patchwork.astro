---
// The patchwork strip from Effa's geometric wall painting (from the mockup).
// Six tile designs repeat across the strip.
interface Props { tiles?: number }
const { tiles = 12 } = Astro.props;
const designs = [
  { bg: '#2F8A4E', kind: 'cross', ink: '#F3D27A' },
  { bg: '#D9A21B', kind: 'diamond', ink: '#A8322A' },
  { bg: '#A8322A', kind: 'zigzag', ink: '#3FB8D6' },
  { bg: '#1E4E6B', kind: 'cross', ink: '#F08A4B' },
  { bg: '#E0457B', kind: 'diamond', ink: '#2F8A4E' },
  { bg: '#3B4F7D', kind: 'zigzag', ink: '#F3D27A' },
];
const cells = Array.from({ length: tiles }, (_, i) => ({ x: 2 + i * 40, ...designs[i % designs.length] }));
const zig = (x: number) =>
  [12, 24, 36].map((y) => `M${x + 4} ${y} l7 -6 l7 6 l7 -6 l7 6`).join(' ');
---
<svg class="patchwork" viewBox={`0 0 ${tiles * 40} 40`} aria-hidden="true" focusable="false">
  {cells.map((c) => (
    <g>
      <rect x={c.x} y="2" width="36" height="36" fill={c.bg} />
      {c.kind === 'cross' && <path d={`M${c.x} 2 L${c.x + 36} 38 M${c.x + 36} 2 L${c.x} 38`} stroke={c.ink} stroke-width="3" />}
      {c.kind === 'diamond' && <path d={`M${c.x + 18} 6 L${c.x + 32} 20 L${c.x + 18} 34 L${c.x + 4} 20 Z`} fill={c.ink} />}
      {c.kind === 'zigzag' && <path d={zig(c.x)} stroke={c.ink} stroke-width="2.5" fill="none" />}
    </g>
  ))}
</svg>

<style>
  .patchwork { width: min(480px, 80%); height: auto; display: block; }
</style>
