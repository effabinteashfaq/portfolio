---
// The narrow Persian rug footer, lifted from the Journey mockup.
import { site } from '../data/site.js';

interface Props { home?: boolean }
const { home = false } = Astro.props;
// rug fringe: one tassel every 12px along the top and bottom edge
const fringe = Array.from({ length: 42 }, (_, i) => 16 + i * 12)
  .map((x) => `M${x} 0V10M${x} 140V150`).join('');
---
<footer class="rug-footer">
  <svg class="rug" viewBox="0 0 520 150" aria-hidden="true" focusable="false">
    <rect x="10" y="10" width="500" height="130" fill="#7A1F24"/>
    <rect x="22" y="20" width="476" height="110" fill="none" stroke="#1F2A44" stroke-width="10"/>
    <rect x="34" y="32" width="452" height="86" fill="#9E2F33"/>
    <rect x="40" y="38" width="440" height="74" fill="none" stroke="#E7C873" stroke-width="2.5" stroke-dasharray="7 5"/>
    <path d="M260 44 L320 75 L260 106 L200 75 Z" fill="#1F2A44"/>
    <path d="M260 54 L300 75 L260 96 L220 75 Z" fill="#E7C873"/>
    <circle cx="260" cy="75" r="9" fill="#9E2F33"/>
    <circle cx="120" cy="75" r="14" fill="none" stroke="#E7C873" stroke-width="2.5"/>
    <circle cx="120" cy="75" r="5" fill="#8FC1AC"/>
    <circle cx="400" cy="75" r="14" fill="none" stroke="#E7C873" stroke-width="2.5"/>
    <circle cx="400" cy="75" r="5" fill="#8FC1AC"/>
    <path d={fringe} stroke="#EADBC3" stroke-width="3"/>
  </svg>

  <p class="rug-footer__log mono"><span class="rug-footer__level">[INFO]</span> {site.footerLog}</p>

  <ul class="rug-footer__links">
    <li><a href={`mailto:${site.email}`}>Email</a></li>
    <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
    <li><a href={site.cv} download>Download CV</a></li>
    <li><a class="rug-footer__top" href={home ? '#courtyard' : '/#courtyard'}>Back to the courtyard ↑</a></li>
  </ul>

  <p class="rug-footer__sign">Effa binte Ashfaq · Islamabad</p>
</footer>

<style>
  .rug-footer {
    background: var(--dusk);
    color: #D9D3C4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 48px var(--gutter) 40px;
    text-align: center;
  }
  .rug { width: min(520px, 92%); height: auto; display: block; }
  .rug-footer__log {
    margin: 0;
    font-size: 13px;
    line-height: 1.9;
    color: #B9C2D6;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .rug-footer__level { color: var(--mint-soft); }
  .rug-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    font-size: 15px;
  }
  .rug-footer__links a { color: var(--mint-soft); display: inline-block; padding: 6px 0; }
  .rug-footer__links a:hover { color: var(--paper); }
  .rug-footer__links .rug-footer__top { color: var(--mustard); }
  .rug-footer__sign {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--paper);
  }
</style>
