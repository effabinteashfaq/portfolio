---
// The Library: reading nook with writeup spines on the middle shelf that open in a
// book beside the chair, then the book-cover grid.
import { getCollection } from 'astro:content';
import RoomHead from '../RoomHead.astro';
import Scene from '../Scene.astro';
import SubHead from '../SubHead.astro';

const writeups = (await getCollection('writeups')).sort((a, b) => a.data.order - b.data.order);
const heights = [92, 84, 96, 80, 88, 94];
const darken = (hex: string, f = 0.75) => {
  const n = parseInt(hex.slice(1), 16);
  const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => Math.round(v * f).toString(16).padStart(2, '0'));
  return `#${c.join('')}`;
};
const fmt = (d?: Date) => d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
const motif: Record<string, string> = {
  'Blue team': '<path d="M12 3 L19 6 V11 C19 15.5 16 19 12 21 C8 19 5 15.5 5 11 V6 Z"/><path d="M9 12 L11 14 L15 10"/>',
  GRC: '<path d="M7 3 H17 A2 2 0 0 1 19 5 V19 A2 2 0 0 1 17 21 H7 A2 2 0 0 1 5 19 V5 A2 2 0 0 1 7 3 Z"/><path d="M9 8 H15 M9 12 H15 M9 16 H13"/>',
  Research: '<circle cx="6" cy="6" r="1.2"/><circle cx="12" cy="6" r="1.2"/><circle cx="18" cy="6" r="1.2"/><circle cx="6" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="18" cy="12" r="1.2"/><circle cx="6" cy="18" r="1.2"/><circle cx="12" cy="18" r="1.2"/><circle cx="18" cy="18" r="1.2"/><path d="M6 18 L12 12 L18 6"/>',
};
const url = (id: string) => `/writeups/${id}/`;
---
<section id="library" aria-labelledby="library-title" class="library">
  <RoomHead id="library-title" urdu="کتاب گھر" urduColor="var(--pink-deep)" title="The Library" intro="Writeups bound like books. Pull one off the shelf." />

  <div class="wrap">
    <div class="nook" data-shelf>
      <Scene name="library" />
      <a href="#writeups" class="plaque">Writeups</a>
      {writeups.map((w, i) => {
        const h = heights[i % heights.length];
        const x = 246 + i * 62, top = 362 - h;
        return (
          <button
            type="button"
            class="spine"
            data-book={w.id}
            aria-pressed="false"
            aria-label={`${w.data.title}, ${w.data.tag}`}
            style={`left:${(x / 12).toFixed(2)}%;top:${(top / 7).toFixed(2)}%;width:${(50 / 12).toFixed(2)}%;height:${(h / 7).toFixed(2)}%;--cover:${w.data.coverColor};--edge:${darken(w.data.coverColor)}`}
          >
            <span>{w.data.tag}</span>
          </button>
        );
      })}
      <div class="open-book" aria-live="polite">
        <p class="open-book__hint" data-book-panel="none">Pick a book from the shelf.</p>
        {writeups.map((w) => (
          <article class="open-book__page" data-book-panel={w.id} hidden>
            <span class="open-book__tag">{w.data.tag}</span>
            <h3 class="open-book__title">{w.data.title}</h3>
            <p class="open-book__excerpt">{w.data.excerpt}</p>
            <a class="open-book__link" href={url(w.id)}>Open the book →</a>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div id="writeups" class="wrap library__covers">
    <SubHead title="Writeups" urdu="تحریر" />
    <ul class="covers">
      {writeups.map((w) => (
        <li>
          <a class="book" href={url(w.id)}>
            <div class="book__cover" aria-hidden="true" style={`--cover:${w.data.coverColor};--edge:${darken(w.data.coverColor)}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="#E7C873" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={motif[w.data.tag] ?? motif.Research} />
              <span>{w.data.tag}</span>
            </div>
            <span class="book__tag">{w.data.tag}{w.data.date && ` · ${fmt(w.data.date)}`}</span>
            <h3 class="book__title">{w.data.title}</h3>
            <span class="book__excerpt">{w.data.excerpt}</span>
            <span class="book__open">Open the book →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .library { background: var(--paper); padding-bottom: 72px; }
  .nook { position: relative; padding-top: 8px; }
  .nook .scene { width: 100%; }

  .plaque {
    position: absolute; left: 18.5%; top: 9%;
    text-decoration: none;
    background: #F3D27A; color: #3A2614;
    border: 3px solid #A86E3E; border-radius: 6px;
    padding: 6px 16px;
    font-family: var(--font-display); font-size: clamp(14px, 1.6vw, 19px); font-weight: 700;
    box-shadow: 0 6px 14px rgba(60, 30, 10, 0.25);
    transition: transform 0.25s ease;
  }
  .plaque:hover, .plaque:focus-visible { transform: translateY(-3px); color: #3A2614; }

  .spine {
    position: absolute;
    padding: 0; margin: 0; border: 0;
    border-radius: 3px 3px 1px 1px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    background: var(--cover);
    box-shadow: inset -5px 0 0 rgba(0, 0, 0, 0.18);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .spine span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-display);
    font-size: clamp(10px, 1.1vw, 14px);
    font-weight: 700;
    line-height: 1;
    color: #F6F0E4;
    white-space: nowrap;
    overflow: hidden;
    max-height: 86%;
  }
  .spine:hover, .spine:focus-visible { transform: translateY(-10px); }
  .spine[aria-pressed='true'] {
    transform: translateY(-14px);
    box-shadow: inset -5px 0 0 rgba(0, 0, 0, 0.18), 0 10px 18px rgba(0, 0, 0, 0.4);
    outline: 2px solid #F3D27A; outline-offset: 2px;
  }

  .open-book {
    position: absolute; left: 66.5%; top: 37%; width: 27%; min-height: 26%;
    background: linear-gradient(90deg, #FBF7EE 0%, #F4ECDC 48%, #E2D6BE 50%, #F4ECDC 52%, #FBF7EE 100%);
    border: 1px solid #D8CDB6;
    border-radius: 4px 4px 10px 10px;
    box-shadow: 0 14px 28px rgba(60, 30, 10, 0.3);
    padding: 14px 18px;
    display: flex; flex-direction: column; justify-content: center;
    color: var(--ink);
  }
  .open-book__hint { margin: 0; text-align: center; font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--ink-muted); }
  .open-book__page { display: flex; flex-direction: column; gap: 6px; animation: page-in 0.3s ease both; }
  .open-book__page[hidden] { display: none; }
  @keyframes page-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .open-book__tag { font-size: 10.5px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ink-muted); }
  .open-book__title { font-size: clamp(15px, 1.5vw, 19px); font-weight: 700; line-height: 1.15; }
  .open-book__excerpt { margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--ink-soft); }
  .open-book__link { font-size: 13px; font-weight: 700; }

  /* Phones: the nook becomes a picture; the covers below do the work */
  @media (max-width: 760px) {
    .spine, .open-book { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .spine, .plaque { transition: none; }
    .open-book__page { animation: none; }
  }

  .library__covers { padding-top: 72px; display: flex; flex-direction: column; gap: 30px; scroll-margin-top: var(--bar-height); }
  .covers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 32px 26px; }
  .book { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 10px; }
  .book__cover {
    aspect-ratio: 2 / 3;
    background: var(--cover);
    border-left: 12px solid var(--edge);
    border-radius: 3px 12px 12px 3px;
    box-shadow: 0 12px 24px rgba(60, 30, 10, 0.22);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px; padding: 18px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .book__cover svg { width: 54px; height: 54px; }
  .book__cover span { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #F6F0E4; text-align: center; }
  .book:hover .book__cover, .book:focus-visible .book__cover { transform: translateY(-6px) rotate(-1deg); box-shadow: 0 18px 30px rgba(60, 30, 10, 0.28); }
  .book__tag { font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ink-muted); }
  .book__title { font-size: 23px; line-height: 1.15; }
  .book__excerpt { font-size: 15px; color: var(--ink-soft); }
  .book__open { font-weight: 700; color: var(--pine); font-size: 15px; }
  .book:hover .book__open { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .book__cover { transition: none; } }
</style>

<script>
  // Library shelf: hovering, focusing or tapping a spine opens it in the book by the chair.
  const shelf = document.querySelector<HTMLElement>('[data-shelf]');
  if (shelf) {
    const spines = shelf.querySelectorAll<HTMLButtonElement>('.spine');
    const pages = shelf.querySelectorAll<HTMLElement>('[data-book-panel]');
    const open = (id: string) => {
      spines.forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.book === id)));
      pages.forEach((p) => (p.hidden = p.dataset.bookPanel !== id));
    };
    spines.forEach((s) => {
      const pick = () => open(s.dataset.book || 'none');
      s.addEventListener('mouseenter', pick);
      s.addEventListener('focus', pick);
      s.addEventListener('click', pick);
    });
  }
</script>
