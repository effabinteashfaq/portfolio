---
// The Corridor: a wall of carved frames around a big mirror.
// Hover, focus or tap a frame and the big mirror shows its details.
import { getCollection } from 'astro:content';
import RoomHead from '../RoomHead.astro';
import Scene from '../Scene.astro';
import Frame from '../Frame.astro';
import AssetImage from '../AssetImage.astro';
import SubHead from '../SubHead.astro';
import ViewToggle from '../ViewToggle.astro';

const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const certs = (await getCollection('certifications')).sort(byOrder);
const cves = (await getCollection('cves')).sort(byOrder);
const certById = Object.fromEntries(certs.map((c) => [c.id, c]));
const cveById = Object.fromEntries(cves.map((c) => [c.id, c]));

// Frame positions on the wall: [left, top, width, height] in % (from the mockup).
type Slot = { id: string; shape: 'niche' | 'rect' | 'oval' | 'small'; box: number[]; paint: string; shade: string; trim: string; cert?: string; cve?: string };
const slots: Slot[] = [
  { id: 'Ltop', shape: 'niche', box: [18.12, 4.65, 6.88, 28.14], paint: '#D9A21B', shade: '#B9850F', trim: '#FBE7A8', cert: 'iso27701-lead-auditor' },
  { id: 'Rtop', shape: 'niche', box: [75.0, 4.65, 6.88, 28.14], paint: '#3F7A64', shade: '#2F5D50', trim: '#BFE0D2', cert: 'skillfront-iso27001-associate' },
  { id: 'Lrect', shape: 'rect', box: [5.62, 15.12, 9.62, 26.86], paint: '#D77F93', shade: '#B9617A', trim: '#FBE0E7', cve: 'CVE-2026-112339' },
  { id: 'Rrect', shape: 'rect', box: [84.75, 15.12, 9.62, 26.86], paint: '#3B4F7D', shade: '#2B3A5E', trim: '#C8D3EE', cve: 'CVE-2026-66874' },
  { id: 'Loval', shape: 'oval', box: [29.38, 30.47, 5.75, 24.3], paint: '#8FC1AC', shade: '#6FA592', trim: '#EAF6F0', cert: 'htb-cdsa' },
  { id: 'Roval', shape: 'oval', box: [64.88, 30.47, 5.75, 24.3], paint: '#C0623A', shade: '#9E4A28', trim: '#F6D3C2', cert: 'iso27001-lead-auditor' },
  { id: 'Lsmall', shape: 'small', box: [18.12, 58.14, 6.88, 21.74], paint: '#3B4F7D', shade: '#2B3A5E', trim: '#C8D3EE', cert: 'secops-cap' },
  { id: 'Rsmall', shape: 'small', box: [75.0, 58.14, 6.88, 21.74], paint: '#D9A21B', shade: '#B9850F', trim: '#FBE7A8', cert: 'secops-cbtp' },
  { id: 'Lbottom', shape: 'niche', box: [6.88, 54.65, 6.88, 28.14], paint: '#C0623A', shade: '#9E4A28', trim: '#F6D3C2', cert: 'cisco-cyber-threat-management' },
  { id: 'Rbottom', shape: 'niche', box: [86.25, 54.65, 6.88, 28.14], paint: '#D77F93', shade: '#B9617A', trim: '#FBE0E7' },
];
// Where the badge sits inside each shape: centre x, centre y, diameter (as % of the frame box)
const badgeSpot = {
  niche: { x: 50, y: 56.4, d: 62 },
  rect: { x: 50, y: 56.2, d: 56 },
  oval: { x: 50, y: 52.6, d: 68 },
  small: { x: 50, y: 42.4, d: 60 },
};
const label = (s: Slot) => {
  if (s.cert) return `${certById[s.cert].data.name}, ${certById[s.cert].data.issuer}`;
  if (s.cve) return `${s.cve}, ${cveById[s.cve].data.product}`;
  return 'Empty mirror, waiting for the next certificate';
};
---
<section id="corridor" aria-labelledby="corridor-title" class="corridor">
  <RoomHead id="corridor-title" urdu="راہداری" title="The Corridor" intro="Certificates and CVE credits, framed on the wall. Hover a frame and the big mirror tells its story." />

  <div class="wrap"><ViewToggle fancy="corridor-wall" list="corridor-list" back="Back to the wall" /></div>

  <div id="corridor-wall">
  <div class="wall-scroll" data-wall>
    <div class="wall">
      <Scene name="corridor-wall" class="wall__bg" />

      <!-- what the big mirror shows -->
      <div class="mirror" aria-live="polite">
        <p class="mirror__hint" data-panel="none">Hover a frame,<br />and the mirror<br />will tell its story.</p>

        {slots.filter((s) => s.cert).map((s) => {
          const c = certById[s.cert!].data;
          return (
            <article class="mirror__card" data-panel={s.id} hidden>
              {c.certificate ? (
                <AssetImage src={c.certificate} alt={`${c.name} certificate`} width={220} class="mirror__img" />
              ) : (
                <AssetImage src={c.badge!} alt={`${c.name} badge`} width={90} class="mirror__img mirror__img--badge" />
              )}
              <span class="mirror__kicker">{c.issuer}</span>
              <h3 class="mirror__title">{c.name}</h3>
              <span class="mirror__meta">Issued {c.issued}{c.validUntil && ` · valid until ${c.validUntil}`}</span>
              {c.credentialId && <span class="mirror__id mono">ID {c.credentialId}</span>}
              {c.verifyUrl ? (
                <a class="mirror__link" href={c.verifyUrl} rel="noopener">Verify →</a>
              ) : c.verifyNote && <span class="mirror__meta">Verify on the {c.verifyNote}</span>}
              <button type="button" class="mirror__enlarge" data-enlarge={s.id}><span class="on-hover">Click</span><span class="on-touch">Tap</span> to enlarge</button>
            </article>
          );
        })}

        {slots.filter((s) => s.cve).map((s) => {
          const v = cveById[s.cve!];
          return (
            <article class="mirror__card" data-panel={s.id} hidden>
              <span class="mirror__kicker">Security advisory · {v.data.date}</span>
              <h3 class="mirror__title">{v.id} ({v.data.product})</h3>
              <span class="mirror__meta">{v.data.severity}</span>
              <span class="mirror__id mono">{v.data.ghsa}</span>
              <a class="mirror__link" href={v.data.url} rel="noopener">Read the advisory →</a>
              <button type="button" class="mirror__enlarge" data-enlarge={s.id}><span class="on-hover">Click</span><span class="on-touch">Tap</span> to enlarge</button>
            </article>
          );
        })}
      </div>

      <!-- the frames -->
      {slots.map((s) => {
        const [l, t, w, h] = s.box;
        const b = badgeSpot[s.shape];
        const c = s.cert ? certById[s.cert].data : null;
        return (
          <button
            type="button"
            class="frame"
            data-slot={s.id}
            data-empty={!s.cert && !s.cve ? 'true' : undefined}
            aria-pressed="false"
            aria-label={label(s)}
            style={`left:${l}%;top:${t}%;width:${w}%;height:${h}%`}
          >
            <Frame shape={s.shape} paint={s.paint} shade={s.shade} trim={s.trim} empty={!s.cert && !s.cve} />
            {(c || s.cve) && (
              <span
                class:list={['frame__badge', { 'frame__badge--plate': s.cve || (c && !c.badge) }]}
                style={`left:${b.x}%;top:${b.y}%;width:${b.d * (s.cve || (c && !c.badge) ? 0.8 : 1)}%`}
                aria-hidden="true"
              >
                {c && c.badge && <AssetImage src={c.badge} alt="" width={96} />}
                {c && !c.badge && <span class="frame__cve frame__cve--iso">27001</span>}
                {s.cve && <span class="frame__cve">CVE</span>}
              </span>
            )}
          </button>
        );
      })}
    </div>
  </div>
  <p class="wall-hint">Swipe sideways to see the whole wall.</p>
  </div>

  <div id="corridor-list" class="wrap" hidden>
    <ul class="cert-list">
      {certs.map((c) => {
        const slot = slots.find((s) => s.cert === c.id);
        return (
          <li class="cert-row">
            <div class="cert-row__main">
              <h3 class="cert-row__name">{c.data.name}</h3>
              <span class="cert-row__meta">{c.data.issuer} · Issued {c.data.issued}{c.data.validUntil && ` · valid until ${c.data.validUntil}`}</span>
              {c.data.credentialId && <span class="cert-row__id mono">ID {c.data.credentialId}</span>}
            </div>
            <div class="cert-row__actions">
              {slot && <button type="button" class="cert-row__view" data-enlarge-slot={slot.id}>View certificate</button>}
              {c.data.verifyUrl ? (
                <a href={c.data.verifyUrl} rel="noopener">Verify →</a>
              ) : c.data.verifyNote && <span class="cert-row__note">Verify on the {c.data.verifyNote}</span>}
            </div>
          </li>
        );
      })}
    </ul>
  </div>

  <dialog class="cert-dialog" data-cert-dialog>
    <div class="cert-dialog__inner">
      <form method="dialog" class="cert-dialog__bar">
        <button class="cert-dialog__close" value="close">Close <span aria-hidden="true">✕</span></button>
      </form>
      {slots.filter((s) => s.cert).map((s) => {
        const c = certById[s.cert!].data;
        return (
          <article class="cert-large" data-large={s.id} hidden>
            {c.certificate ? (
              <AssetImage src={c.certificate} alt={`${c.name} certificate`} width={876} class="cert-large__img" />
            ) : (
              <AssetImage src={c.badge!} alt={`${c.name} badge`} width={260} class="cert-large__img cert-large__img--badge" />
            )}
            <div class="cert-large__text">
              <span class="cert-large__kicker">{c.issuer}</span>
              <h3 class="cert-large__title" data-dialog-title>{c.name}</h3>
              <dl class="cert-large__facts">
                <div><dt>Issued</dt><dd>{c.issued}</dd></div>
                {c.validUntil && <div><dt>Valid until</dt><dd>{c.validUntil}</dd></div>}
                {c.credentialId && <div><dt>Credential ID</dt><dd class="mono">{c.credentialId}</dd></div>}
              </dl>
              {c.verifyUrl ? (
                <a class="btn btn-ink cert-large__verify" href={c.verifyUrl} rel="noopener">Verify →</a>
              ) : c.verifyNote && <p class="cert-large__note">Verify on the {c.verifyNote}.</p>}
            </div>
          </article>
        );
      })}
      {slots.filter((s) => s.cve).map((s) => {
        const v = cveById[s.cve!];
        return (
          <article class="cert-large cert-large--cve" data-large={s.id} hidden>
            <div class="cert-large__text">
              <span class="cert-large__kicker">Security advisory · {v.data.date}</span>
              <h3 class="cert-large__title" data-dialog-title>{v.id} ({v.data.product})</h3>
              <dl class="cert-large__facts">
                <div><dt>Severity</dt><dd>{v.data.severity}</dd></div>
                <div><dt>Advisory</dt><dd class="mono">{v.data.ghsa}</dd></div>
              </dl>
              <p class="cert-large__desc">{v.data.description}</p>
              <a class="btn btn-ink cert-large__verify" href={v.data.url} rel="noopener">Read the advisory →</a>
            </div>
          </article>
        );
      })}
    </div>
  </dialog>

  <div class="wrap corridor__cves">
    <SubHead title="Security research and disclosures" level={3} />
    <ul class="cves">
      {cves.map((v) => (
        <li class="cve">
          <div class="cve__head">
            <span class="cve__id mono">{v.id}</span>
            <span class="cve__product">{v.data.product}</span>
          </div>
          <span class="cve__meta">{v.data.ghsa} · {v.data.severity} · {v.data.date}</span>
          <p class="cve__desc">{v.data.description}</p>
          <a href={v.data.url} rel="noopener">Read the advisory →</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .corridor { background: var(--paper-deep); padding-bottom: 96px; }

  .wall-scroll { overflow-x: auto; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
  .wall { position: relative; min-width: 1000px; max-width: 1440px; margin: 0 auto; aspect-ratio: 1600 / 860; }
  .wall__bg { position: absolute; inset: 0; }
  .wall__bg :global(svg) { width: 100%; height: 100%; border-radius: 24px; }
  .wall-hint { display: none; text-align: center; font-size: 14px; color: var(--ink-muted); margin: 8px 0 0; }
  @media (max-width: 1000px) { .wall-hint { display: block; } }

  /* the big mirror's glass area */
  .mirror {
    position: absolute;
    left: 41.9%; top: 18.6%; width: 16.2%; height: 38%;
    padding: 6px 4px;
    display: flex; flex-direction: column; justify-content: center;
    overflow: hidden;
  }
  .mirror__hint {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.3;
    color: #2E4450;
  }
  .mirror__card {
    background: rgba(251, 244, 230, 0.95);
    border-radius: 6px;
    padding: 8px 10px 10px;
    display: flex; flex-direction: column; gap: 3px;
    max-height: 100%;
    overflow: auto;
    animation: mirror-in 0.3s ease both;
  }
  .mirror__card[hidden] { display: none; }
  @keyframes mirror-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .mirror__card { animation: none; } }
  .mirror__card :global(.mirror__img) { display: block; width: 100%; height: auto; border-radius: 3px; margin-bottom: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
  .mirror__card :global(.mirror__img--badge) { width: 64px; margin: 0 auto 4px; box-shadow: none; }
  .mirror__kicker { font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--ink-muted); }
  .mirror__title { font-size: clamp(15px, 1.25vw, 18px); font-weight: 700; line-height: 1.12; color: var(--ink); }
  .mirror__meta { font-size: 11.5px; line-height: 1.35; color: var(--ink-soft); }
  .mirror__id { font-size: 10.5px; color: var(--ink-muted); word-break: break-all; }
  .mirror__link { font-size: 12.5px; font-weight: 700; }
  .mirror__enlarge {
    align-self: flex-start;
    margin-top: 2px; padding: 2px 0;
    background: none; border: 0;
    font: inherit; font-size: 11.5px; font-weight: 700;
    color: var(--pine);
    cursor: zoom-in;
    text-decoration: underline dotted;
  }
  .on-touch { display: none; }
  @media (hover: none) { .on-hover { display: none; } .on-touch { display: inline; } }
  /* the mirror glows and shows a zoom cursor when a card can be enlarged */
  .mirror[data-has-card] { cursor: zoom-in; border-radius: 40% 40% 4px 4px / 14% 14% 4px 4px; transition: box-shadow 0.3s ease; }
  .mirror[data-has-card]:hover { box-shadow: 0 0 0 3px rgba(231, 200, 115, 0.7), 0 0 24px rgba(255, 215, 120, 0.6); }

  /* large view */
  .cert-dialog {
    width: min(920px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .cert-dialog::backdrop { background: rgba(20, 18, 34, 0.82); }
  .cert-dialog__inner { padding: 14px 22px 24px; }
  .cert-dialog__bar { display: flex; justify-content: flex-end; margin: 0 0 6px; }
  .cert-dialog__close {
    background: none; border: 1.5px solid var(--ink); border-radius: 999px;
    padding: 8px 16px; min-height: 40px;
    font: inherit; font-weight: 700; color: var(--ink); cursor: pointer;
  }
  .cert-dialog__close:hover { background: var(--ink); color: var(--paper); }
  .cert-large { display: flex; flex-direction: column; gap: 18px; }
  .cert-large[hidden] { display: none; }
  .cert-large :global(.cert-large__img) { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18); }
  .cert-large :global(.cert-large__img--badge) { width: 220px; margin: 0 auto; box-shadow: none; }
  .cert-large__text { display: flex; flex-direction: column; gap: 8px; }
  .cert-large__kicker { font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ink-muted); }
  .cert-large__title { font-size: clamp(24px, 3.5vw, 32px); line-height: 1.15; }
  .cert-large__facts { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .cert-large__facts div { display: flex; flex-direction: column; }
  .cert-large__facts dt { font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted); }
  .cert-large__facts dd { margin: 0; font-weight: 700; }
  .cert-large__desc, .cert-large__note { margin: 4px 0 0; color: var(--ink-soft); }
  .cert-large__verify { align-self: flex-start; margin-top: 8px; }

  /* frames */
  .frame {
    position: absolute;
    padding: 0; margin: 0;
    background: transparent; border: 0;
    cursor: pointer;
    z-index: 2;
    filter: drop-shadow(0 6px 8px rgba(60, 40, 20, 0.25));
    transition: transform 0.35s ease, filter 0.35s ease;
  }
  .frame :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .frame:hover, .frame:focus-visible { transform: translateY(-3px); }
  .frame[aria-pressed='true'] {
    z-index: 5;
    transform: translateY(-4px) scale(1.04);
    filter: drop-shadow(0 0 10px rgba(255, 205, 90, 0.95)) drop-shadow(0 6px 10px rgba(60, 40, 20, 0.3));
  }
  .frame:focus-visible { outline: 3px solid var(--mustard-deep); outline-offset: 4px; }
  .frame__badge {
    position: absolute;
    transform: translate(-50%, -50%);
    aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none;
    filter: drop-shadow(0 3px 4px rgba(30, 15, 5, 0.45));
  }
  .frame__badge :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }
  /* SkillFront and the CVE frames get a round lettered plate */
  .frame__badge--plate { border-radius: 50%; border: 2px solid #E7C873; overflow: hidden; background: #FBF4E6; }
  /* SkillFront has no badge: a lettered plate in the mockup's ISO style */
  .frame__cve.frame__cve--iso { background: var(--pine); color: var(--paper); font-size: clamp(8px, 0.85vw, 12.5px); }
  .frame__cve { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--ink); color: var(--mustard); font-weight: 700; font-size: clamp(11px, 1.1vw, 16px); }
  @media (prefers-reduced-motion: reduce) { .frame { transition: none; } }

  /* list view */
  .cert-list { list-style: none; margin: 0; padding: 0; background: #FBF7EE; border: 1px solid var(--paper-line); border-radius: 16px; overflow: hidden; }
  .cert-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; padding: 18px 24px; border-bottom: 1px solid var(--paper-line); }
  .cert-row:last-child { border-bottom: 0; }
  .cert-row__main { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .cert-row__name { font-size: 23px; line-height: 1.2; }
  .cert-row__meta { font-size: 14px; color: var(--ink-soft); }
  .cert-row__id { font-size: 13px; color: var(--ink-muted); overflow-wrap: anywhere; }
  .cert-row__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; font-weight: 700; font-size: 15px; }
  .cert-row__view {
    background: none; border: 1.5px solid var(--pine); border-radius: 999px;
    padding: 7px 14px; min-height: 40px;
    font: inherit; font-size: 14px; font-weight: 700; color: var(--pine); cursor: zoom-in;
  }
  .cert-row__view:hover { background: var(--pine); color: var(--paper); }
  .cert-row__note { font-size: 13px; font-weight: 400; color: var(--ink-muted); }

  /* CVE list */
  .corridor__cves { padding-top: 56px; display: flex; flex-direction: column; gap: 20px; }
  .cves { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 20px; }
  .cve { background: #FBF7EE; border: 1px solid var(--paper-line); border-left: 6px solid var(--ink); border-radius: 14px; padding: 22px 24px; display: flex; flex-direction: column; gap: 6px; }
  .cve__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .cve__id { font-weight: 700; font-size: 16px; }
  .cve__product { font-family: var(--font-display); font-size: 24px; font-weight: 600; }
  .cve__meta { font-size: 14px; font-weight: 700; color: var(--pine); }
  .cve__desc { margin: 0; color: var(--ink-soft); }
  .cve a { font-weight: 700; }
</style>

<script>
  // Mirror wall: hovering, focusing or tapping a frame shows its story in the big mirror.
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  if (wall) {
    const frames = wall.querySelectorAll<HTMLButtonElement>('.frame');
    const panels = wall.querySelectorAll<HTMLElement>('[data-panel]');
    const show = (id: string) => {
      frames.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.slot === id)));
      let found = false;
      panels.forEach((p) => {
        const on = p.dataset.panel === id;
        p.hidden = !on;
        if (on) found = true;
      });
      // empty mirrors (no panel) bring back the hint
      if (!found) panels.forEach((p) => (p.hidden = p.dataset.panel !== 'none'));
      current = found ? id : 'none';
      if (found) mirror?.setAttribute('data-has-card', '');
      else mirror?.removeAttribute('data-has-card');
    };
    // large view
    const mirror = wall.querySelector<HTMLElement>('.mirror');
    const dialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]');
    let current = 'none';
    const enlarge = (id = current) => {
      if (!dialog || id === 'none') return;
      let title = '';
      dialog.querySelectorAll<HTMLElement>('[data-large]').forEach((a) => {
        a.hidden = a.dataset.large !== id;
        if (!a.hidden) title = a.querySelector('[data-dialog-title]')?.textContent || '';
      });
      dialog.setAttribute('aria-label', title);
      dialog.showModal();
    };
    mirror?.addEventListener('click', (e) => {
      // links inside the mirror (Verify) keep working as normal links
      if ((e.target as HTMLElement).closest('a')) return;
      enlarge();
    });
    // "View certificate" buttons in the list view open the same large view
    document.querySelectorAll<HTMLButtonElement>('[data-enlarge-slot]').forEach((b) =>
      b.addEventListener('click', () => enlarge(b.dataset.enlargeSlot))
    );
    // clicking the dark area outside the box closes it
    dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    frames.forEach((f) => {
      const pick = () => show(f.dataset.slot || 'none');
      f.addEventListener('mouseenter', pick);
      f.addEventListener('focus', pick);
      f.addEventListener('click', pick);
    });
  }
</script>
