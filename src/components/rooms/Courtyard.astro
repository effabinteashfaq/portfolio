---
// Courtyard (hero): name, stage name, role, intro, Now line, and Beyond the Screen.
import Scene from '../Scene.astro';
import { site } from '../../data/site.js';
---
<section id="courtyard" aria-labelledby="courtyard-title" class="courtyard">
  <div class="wrap hero">
    <div class="hero__text">
      <p class="urdu hero__urdu" lang="ur" dir="rtl">خوش آمدید</p>
      <div class="hero__name">
        <h1 id="courtyard-title">Effa binte Ashfaq</h1>
        <p class="mono hero__aka">aka 3FFYP4CK</p>
      </div>
      <p class="hero__role">Security Researcher &amp; GRC Analyst</p>
      <p class="hero__lead">I work where policy meets the logs.</p>
      <p class="hero__intro">On the GRC side, that means reading standards closely, mapping controls and finding the gaps before an auditor does. On the blue team side, it means digging through alerts, timelines and memory dumps to see what really happened. My favourite moment is when both sides tell the same story. Away from the screen, I paint, chase mountain light with my camera, and never say no to a good paratha.</p>
      <p class="hero__now"><b>Now:</b> Masters in Information Security at MCS, NUST</p>
      <div class="hero__actions">
        <a class="btn btn-ink" href="#study">Walk through the haveli ↓</a>
        <a class="btn btn-outline" href={site.cv} download>Download CV</a>
      </div>
      <ul class="hero__links">
        <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </div>
    <figure class="hero__figure">
      <Scene name="hero" />
      <figcaption class="hero__caption">Scanning the horizon, the old-fashioned way.</figcaption>
    </figure>
  </div>

</section>

<style>
  .hero {
    padding-top: 56px;
    padding-bottom: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 48px;
  }
  .hero__text { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .hero__urdu { margin: 0; font-size: 26px; color: var(--pine); text-align: left; }
  .hero__name { display: flex; flex-direction: column; gap: 6px; }
  .hero__name h1 { font-size: clamp(48px, 8.5vw, 76px); line-height: 1.02; }
  .hero__aka { margin: 0; font-size: 15px; letter-spacing: 1px; color: var(--ink-muted); }
  .hero__role {
    margin: 4px 0 0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--pine);
  }
  .hero__lead {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 32px);
    line-height: 1.3;
    color: var(--ink);
  }
  .hero__intro { margin: 0; max-width: 560px; color: var(--ink-soft); }
  .hero__now { margin: 0; font-size: 16px; color: var(--ink-soft); }
  .hero__now b { color: var(--ink); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 4px; }
  .hero__links { list-style: none; margin: 0; padding: 0; display: flex; gap: 20px; font-size: 15px; }
  .hero__links a { display: inline-block; padding: 6px 0; }
  .hero__figure { flex: 1 1 440px; min-width: 0; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .hero__figure .scene { width: 100%; max-width: 540px; }
  .hero__caption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 17px;
    color: var(--ink-muted);
    text-align: center;
  }

</style>
