---
// Shows a picture from assets/ (badges, certificates, figures).
// Astro converts it to small WebP files at build time.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/assets/**/*.{png,jpg,jpeg,webp}', { eager: true });

interface Props {
  src: string;          // e.g. "assets/badges/htb-cdsa.png"
  alt: string;
  width: number;        // display width in CSS pixels
  class?: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, width, class: className, loading = 'lazy' } = Astro.props;
const img = images[`/${src}`];
if (!img) throw new Error(`Image not found: ${src}`);
---
<Image
  src={img.default}
  alt={alt}
  width={width}
  densities={[1, 2]}
  format="webp"
  quality={82}
  loading={loading}
  class={className}
/>
