---
// A handful of chinar leaves that blow across a threshold once, like an autumn breeze.
// Positions are "random" but fixed per threshold (seeded), so every doorway differs.
interface Props { seed: number; count?: number }
const { seed, count = 10 } = Astro.props;

// small seeded random number generator (mulberry32)
let a = seed >>> 0;
const rand = () => {
  a = (a + 0x6d2b79f5) >>> 0;
  let t = a;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (lo: number, hi: number) => lo + rand() * (hi - lo);

// mustard, rust, amber, wildflower pink, pine, deep rust, soft pink
const colours = ['#D9A21B', '#B5562F', '#E08A3C', '#C76B7E', '#2F5D50', '#9E3F2A', '#D77F93', '#E7C873'];

const leaves = Array.from({ length: count }, (_, i) => {
  const dur = Math.round(between(700, 860));
  const delay = Math.round(between(0, 120));          // dur + delay always under 1s
  return {
    colour: colours[(i * 3 + seed) % colours.length],
    size: Math.round(between(26, 50)),
    x: between(-6, 72).toFixed(1),                       // % across the strip
    y: between(4, 58).toFixed(1),                        // % down the strip
    dx: between(18, 32).toFixed(1),                      // vw travelled sideways
    dy: Math.round(between(28, 78)),                     // px travelled down
    lift: Math.round(between(6, 22)),                    // little upward float mid-way
    r0: Math.round(between(-40, 40)),
    spin: Math.round(between(120, 300)) * (rand() < 0.3 ? -1 : 1),
    sway: Math.round(between(12, 26)),
    flip: rand() < 0.35 ? -1 : 1,                        // about a third turn right over
    dur,
    delay,
  };
});
---
<div class="breeze" aria-hidden="true">
  {leaves.map((l) => (
    <span
      class="leaf"
      style={`left:${l.x}%;top:${l.y}%;--dx:${l.dx}vw;--dy:${l.dy}px;--lift:${l.lift}px;--dur:${l.dur}ms;--delay:${l.delay}ms;`}
    >
      <svg
        class="leaf__body"
        width={l.size}
        height={l.size}
        style={`color:${l.colour};--r0:${l.r0}deg;--spin:${l.spin}deg;--sway:${l.sway}deg;--flip:${l.flip};`}
        focusable="false"
      ><use href="#chinar" /></svg>
    </span>
  ))}
</div>

<style>
  .breeze { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .leaf { position: absolute; opacity: 0; }
  .leaf__body { display: block; overflow: visible; }

  /* The breeze runs once, when the threshold scrolls into view (see motion.ts). */
  :global(.is-breezing) .leaf {
    animation: leaf-drift var(--dur) cubic-bezier(0.22, 0.55, 0.35, 1) var(--delay) both;
    will-change: transform, opacity;
  }
  :global(.is-breezing) .leaf__body {
    animation: leaf-flutter var(--dur) ease-in-out var(--delay) both;
  }

  /* the path: a diagonal drift with a small float upward mid-way */
  @keyframes leaf-drift {
    0%   { transform: translate(0, 0); opacity: 0; }
    14%  { opacity: 1; }
    50%  { transform: translate(calc(var(--dx) * 0.52), calc(var(--dy) * 0.3 - var(--lift))); }
    76%  { opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)); opacity: 0; }
  }
  /* the leaf itself: sways and spins; some tilt, about a third turn right over (flat 2D) */
  @keyframes leaf-flutter {
    0%   { transform: rotate(var(--r0)) scaleX(1); }
    30%  { transform: rotate(calc(var(--r0) + var(--sway))) scaleX(0.62); }
    58%  { transform: rotate(calc(var(--r0) + var(--spin) * 0.55 - var(--sway))) scaleX(calc(var(--flip) * 0.92)); }
    80%  { transform: rotate(calc(var(--r0) + var(--spin) * 0.8)) scaleX(calc(var(--flip) * 0.6)); }
    100% { transform: rotate(calc(var(--r0) + var(--spin))) scaleX(calc(var(--flip) * 0.88)); }
  }

  /* Visitors who prefer less motion see only the patchwork strip. */
  @media (prefers-reduced-motion: reduce) {
    .breeze { display: none; }
  }
</style>
