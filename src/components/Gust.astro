---
// The autumn breeze: a slow, full-screen gust of mist and chinar leaves that
// swirl in loops across the page (about 2 seconds), then clear to reveal the next room.
// Rendered once per page; src/scripts/motion.ts plays it at each threshold.
// Three variants (different leaves and mist) are cycled so doorways differ.

interface Props { variants?: number; leaves?: number }
const { variants = 3, leaves = 16 } = Astro.props;

const colours = ['#D9A21B', '#B5562F', '#E08A3C', '#C76B7E', '#2F5D50', '#9E3F2A', '#D77F93', '#E7C873'];

const makeRand = (seed: number) => {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
};

const sets = Array.from({ length: variants }, (_, v) => {
  const rand = makeRand(1009 + v * 7919);
  const between = (lo: number, hi: number) => lo + rand() * (hi - lo);
  const leafList = Array.from({ length: leaves }, (_, i) => {
    const dur = Math.round(between(1600, 2000));
    const x = between(-6, 34);                     // vw: some leaves are already in the air
    return {
      x: x.toFixed(1),
      tx: (110 - x + between(0, 10)).toFixed(1),     // vw travelled, always off the right edge
      colour: colours[(i * 5 + v * 3) % colours.length],
      size: Math.round(between(30, 62)),
      y: between(4, 88).toFixed(1),                  // vh, where it enters
      dy: Math.round(between(-14, 18)),              // vh it rises or falls while crossing
      dur,
      delay: Math.round(between(0, 220)),
      radius: Math.round(between(30, 120)),          // size of its loops, px
      turns: Math.round(between(300, 820)) * (rand() < 0.5 ? -1 : 1), // degrees of looping
      spin: Math.round(between(200, 540)) * (rand() < 0.4 ? -1 : 1),
      flip: rand() < 0.4 ? -1 : 1,
    };
  });
  const mist = Array.from({ length: 5 }, () => ({
    y: between(-10, 70).toFixed(1),                  // vh
    w: Math.round(between(70, 115)),                 // vw
    h: Math.round(between(35, 65)),                  // vh
    dur: Math.round(between(1800, 2200)),
    delay: Math.round(between(0, 200)),
    peak: between(0.55, 0.85).toFixed(2),
  }));
  return { leafList, mist };
});
---
<div class="gust" data-gust aria-hidden="true">
  {sets.map((set, v) => (
    <div class="gust__set" data-set={v}>
      <div class="gust__veil"></div>
      {set.mist.map((m) => (
        <span class="mist" style={`top:${m.y}vh;width:${m.w}vw;height:${m.h}vh;--dur:${m.dur}ms;--delay:${m.delay}ms;--peak:${m.peak}`}></span>
      ))}
      {set.leafList.map((l) => (
        <span class="gleaf" style={`top:${l.y}vh;left:${l.x}vw;--tx:${l.tx}vw;--dy:${l.dy}vh;--dur:${l.dur}ms;--delay:${l.delay}ms`}>
          <span class="gleaf__orbit" style={`--turns:${l.turns}deg`}>
            <span class="gleaf__arm" style={`--r:${l.radius}px`}>
              <svg class="gleaf__body" width={l.size} height={l.size} focusable="false"
                style={`color:${l.colour};--spin:${l.spin}deg;--flip:${l.flip}`}><use href="#chinar" /></svg>
            </span>
          </span>
        </span>
      ))}
    </div>
  ))}
</div>

<style>
  /* Full screen, above the rooms but below the top bar. Never catches clicks or scrolling. */
  .gust { position: fixed; inset: 0; z-index: 45; pointer-events: none; overflow: hidden; visibility: hidden; }
  .gust:global(.is-playing) { visibility: visible; }
  .gust__set { position: absolute; inset: 0; display: none; }
  .gust:global(.is-playing[data-play='0']) .gust__set[data-set='0'],
  .gust:global(.is-playing[data-play='1']) .gust__set[data-set='1'],
  .gust:global(.is-playing[data-play='2']) .gust__set[data-set='2'] { display: block; }

  /* a faint warm veil that peaks as the mist passes, then lifts to reveal the room */
  .gust__veil {
    position: absolute; inset: 0;
    background: rgba(251, 246, 236, 0.32);
    opacity: 0;
    animation: veil 2000ms ease-in-out both;
  }
  @keyframes veil { 0% { opacity: 0; } 35% { opacity: 1; } 100% { opacity: 0; } }

  /* mist: soft drifts rolling in from the left */
  .mist {
    position: absolute;
    left: -45vw;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 251, 242, 0.95), rgba(255, 251, 242, 0.55) 45%, rgba(255, 251, 242, 0) 100%);
    opacity: 0;
    animation: mist-roll var(--dur) cubic-bezier(0.3, 0.1, 0.4, 1) var(--delay) both;
    will-change: transform, opacity;
  }
  @keyframes mist-roll {
    0%   { transform: translateX(0) scale(0.9); opacity: 0; }
    30%  { opacity: var(--peak); }
    65%  { opacity: calc(var(--peak) * 0.8); }
    100% { transform: translateX(150vw) scale(1.15); opacity: 0; }
  }

  /* leaves: travel across the whole screen... */
  .gleaf {
    position: absolute;
    animation: gleaf-cross var(--dur) cubic-bezier(0.35, 0.15, 0.55, 0.9) var(--delay) both;
    will-change: transform, opacity;
  }
  @keyframes gleaf-cross {
    0%   { transform: translate(0, 0); opacity: 0; }
    5%   { opacity: 1; }
    90%  { opacity: 1; }
    100% { transform: translate(var(--tx), var(--dy)); opacity: 0; }
  }
  /* ...while circling around a moving centre, which draws loops and swirls */
  .gleaf__orbit {
    position: absolute;
    animation: gleaf-orbit var(--dur) ease-in-out var(--delay) both;
  }
  @keyframes gleaf-orbit { from { transform: rotate(0deg); } to { transform: rotate(var(--turns)); } }
  .gleaf__arm { position: absolute; transform: translateX(var(--r)); }
  /* ...and fluttering: spinning, some turning right over (flat 2D) */
  .gleaf__body {
    display: block;
    max-width: none;   /* the moving boxes around a leaf have no width of their own */
    overflow: visible;
    animation: gleaf-flutter var(--dur) ease-in-out var(--delay) both;
  }
  @keyframes gleaf-flutter {
    0%   { transform: rotate(0deg) scaleX(1); }
    25%  { transform: rotate(calc(var(--spin) * 0.25)) scaleX(0.6); }
    50%  { transform: rotate(calc(var(--spin) * 0.5)) scaleX(calc(var(--flip) * 0.95)); }
    75%  { transform: rotate(calc(var(--spin) * 0.75)) scaleX(calc(var(--flip) * 0.55)); }
    100% { transform: rotate(var(--spin)) scaleX(0.9); }
  }

  /* Reduced motion (device setting by default, or the button in the top bar): no gust */
  :global(html[data-motion='off']) .gust { display: none; }
</style>
