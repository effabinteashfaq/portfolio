---
// The doorway between two rooms: a colour fade, the patchwork strip and
// an "onward to" line. Scrolling into it plays the autumn breeze (Gust.astro).
import Patchwork from './Patchwork.astro';

interface Props {
  from: string;   // background colour of the room above
  to: string;     // background colour of the room below
  via?: string;   // optional colour the fade passes through
  urdu: string;   // Urdu name of the next room
  next: string;   // English name of the next room, e.g. "the Study"
}
const { from, to, via, urdu, next } = Astro.props;
const fade = via ? `${from}, ${via}, ${to}` : `${from}, ${to}`;
---
<div class="threshold" aria-hidden="true" data-breeze style={`--fade:${fade}`}>
  <Patchwork />
  <span class="threshold__line">onward to <span class="urdu" lang="ur" dir="rtl">{urdu}</span> · {next}</span>
</div>

<style>
  .threshold {
    position: relative;
    height: 200px;
    overflow: hidden;
    background: linear-gradient(var(--fade));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .threshold__line {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    /* a small paper tag keeps the text readable over the colour fade */
    color: var(--ink);
    background: rgba(246, 240, 228, 0.92);
    padding: 2px 16px;
    border-radius: 999px;
  }
  .threshold__line .urdu { font-size: 0.95em; line-height: 1; }
</style>
