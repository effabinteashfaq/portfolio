{
  "name": "effa-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs && node scripts/render-mermaid.mjs",
    "predev": "npm run prepare-assets",
    "dev": "astro dev",
    "prebuild": "npm run prepare-assets",
    "build": "astro build",
    "preview": "astro preview",
    "fresh": "astro dev stop; rm -rf .astro node_modules/.astro node_modules/.vite dist && npm run dev -- --host --port 4321",
    "optimise-svg": "svgo -r -f src/scenes --config svgo.config.mjs",
    "subset-urdu": "node scripts/subset-urdu.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "astro": "7.4.13"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "lighthouse": "^13.6.0",
    "mermaid": "^12.3.0",
    "subset-font": "^2.9.0",
    "svgo": "^4.1.0"
  }
}
